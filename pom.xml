<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0
                             http://maven.apache.org/xsd/maven-4.1.0.xsd"
         root="true">
    <modelVersion>4.1.0</modelVersion>

    <groupId>net.aschemann.maven.demos</groupId>
    <artifactId>analyzer</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <name>Text Analyzer</name>
    <description>A modular text analyzer demonstrating Java Modules (JPMS) with Maven 4</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <!-- Dependency versions -->
        <log4j.version>2.24.3</log4j.version>
        <picocli.version>4.7.7</picocli.version>

        <!-- Plugin versions -->
        <maven-compiler-plugin.version>4.0.0-beta-3</maven-compiler-plugin.version>
        <maven-dependency-plugin.version>3.8.1</maven-dependency-plugin.version>
    </properties>

    <dependencies>
        <!-- Log4j 2.x (modular) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Picocli for CLI (modular) -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>
    </dependencies>

    <build>
        <!-- tag::sources[] -->
        <sources>
            <source>
                <module>net.aschemann.maven.demos.analyzer.api</module> <!--1-->
            </source>
            <source>
                <module>net.aschemann.maven.demos.analyzer.core</module> <!--2-->
            </source>
            <source>
                <module>net.aschemann.maven.demos.analyzer.cli</module> <!--3-->
            </source>
        </sources>
        <!-- end::sources[] -->

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
            </plugin>
            <!--
                WORKAROUND: Explicit resource copying until Maven Core PR 11505 is released.
                See: https://github.com/apache/maven/pull/11505
            -->
            <!-- tag::resources-workaround[] -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-cli-resources</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/net.aschemann.maven.demos.analyzer.cli</outputDirectory> <!--1-->
                            <resources>
                                <resource>
                                    <directory>src/net.aschemann.maven.demos.analyzer.cli/main/resources</directory> <!--2-->
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- end::resources-workaround[] -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${maven-dependency-plugin.version}</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- tag::jar[] -->
            <!--
                With JAR Plugin PR 508 the Maven 4 module source hierarchy is packaged into one
                properly-named JAR per module automatically (analyzer.api / .core / .cli), replacing
                the explicit per-module executions and classifiers of the earlier workaround.
                Uses a pre-release SNAPSHOT until PR 508 is released.
                See: https://github.com/apache/maven-jar-plugin/pull/508
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>4.0.0-beta-2-SNAPSHOT</version>
            </plugin>
            <!-- end::jar[] -->
        </plugins>
    </build>
</project>
